WECHAT_APP_ID=
WECHAT_APP_SECRET=
RELAY_TOKEN=
# --- Docker Compose 专用(非容器部署可忽略) ---
# 宿主机数据目录(SQLite 落盘处),默认 ./data
DATA_DIR=
# 构建期镜像源(境内加速可选),例:
#   APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
#   NPM_REGISTRY=https://registry.npmmirror.com
APT_MIRROR=
NPM_REGISTRY=
# --- 以下为运行时配置;compose 部署中 HOST/PORT/DB_PATH 已固定,留空即可 ---
HOST=
PORT=
DB_PATH=
MAX_JSON_BODY_BYTES=
MAX_MEDIA_BODY_BYTES=
MAX_UPSTREAM_RESPONSE_BYTES=
BODY_TIMEOUT_MS=
UPSTREAM_TIMEOUT_MS=
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX_REQUESTS=
HEALTH_RATE_LIMIT_MAX_REQUESTS=
PREAUTH_RATE_LIMIT_MAX_REQUESTS=
MAX_CONCURRENT_UPSTREAM=
MAX_CONNECTIONS=
IDEMPOTENCY_MAX_RECORDS=
IDEMPOTENCY_FAILED_SAFE_RETENTION_MS=
